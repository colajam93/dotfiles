if has('gui_gtk') && executable('fc-match')
    " Fontconfig may return a fallback, so require the exact family name.
    let s:font = trim(system('fc-match -f "%{family}" HackGen'))
    if v:shell_error == 0 && s:font ==# 'HackGen'
        set guifont=HackGen\ 13
    endif
endif

